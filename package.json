{
  "name": "pinterest-ai-agent",
  "version": "1.0.0",
  "description": "Telegram-controlled Pinterest AI quote generator, multi-board scheduler and publisher",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:migrate:dev": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "render:sample": "tsx scripts/render-sample.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@google/genai": "^2.30.0",
    "bullmq": "^6.3.15",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}

# ---------- App ----------
NODE_ENV=production
APP_BASE_URL=https://your-api-service.up.railway.app
PORT=3000
LOG_LEVEL=info

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token (A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs allowed to use the bot
AUTHORIZED_TELEGRAM_USER_IDS=
# true = long polling (local dev only); false = webhook at APP_BASE_URL/telegram/webhook
TELEGRAM_USE_POLLING=false
BOT_RATE_LIMIT_PER_MINUTE=30

# ---------- Railway PostgreSQL / Redis (use Railway variable references) ----------
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SSL=false
REDIS_URL=${{Redis.REDIS_URL}}

# ---------- Pinterest (developers.pinterest.com → My apps) ----------
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=https://your-api-service.up.railway.app/oauth/pinterest/callback
# Trial access apps can only create pins via the sandbox API: https://api-sandbox.pinterest.com/v5
PINTEREST_API_BASE=https://api.pinterest.com/v5
PINTEREST_SCOPES=boards:read,boards:write,pins:read,pins:write,user_accounts:read

# ---------- AI (Google Gemini / Imagen via Google AI Studio key) ----------
AI_TEXT_PROVIDER=gemini
AI_TEXT_API_KEY=
AI_TEXT_MODEL=gemini-3.8-flash
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_IMAGE_PROVIDER=gemini
# Leave empty to reuse AI_TEXT_API_KEY
AI_IMAGE_API_KEY=
# Gemini image model (Imagen 4 was shut down in Aug 2026)
AI_IMAGE_MODEL=gemini-nano-banana-2.1

# ---------- Cloudflare R2 ----------
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public HTTPS base for the bucket (custom domain or r2.dev URL), no trailing slash
R2_PUBLIC_BASE_URL=https://images.example.com

# ---------- Security ----------
# 32 random bytes as 64 hex chars:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ---------- Defaults & tuning ----------
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_BATCH_SIZE=5
DEFAULT_SCHEDULE_INTERVAL_MINUTES=60
MAX_BATCH_SIZE=7
MISSED_SCHEDULE_POLICY=shift
MISSED_SCHEDULE_GRACE_MINUTES=10
GENERATION_CONCURRENCY=1
IMAGE_CONCURRENCY=2
PUBLISH_CONCURRENCY=1
PUBLISH_MAX_ATTEMPTS=4
DRAFT_IMAGE_RETENTION_DAYS=14
